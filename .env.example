# Copy this file to ".env" and fill in your own values.
# ".env" is gitignored -- never commit it, it can end up holding OAuth
# paths specific to your machine.

# ---- Server -----------------------------------------------------------

# Port the local server listens on. OBS Browser Sources and bot/bot.js
# both default to this same port via http://localhost:<PORT>.
PORT=3000

# ---- Chat-earned currency (Point Spinner + Live Auction) --------------

# Display name for the currency everyone earns just by chatting, spent on
# !spin (Point Spinner) and bid on in Live Auction.
CURRENCY_NAME=Points

# How much CURRENCY_NAME a viewer earns per eligible chat message. This is
# only the INITIAL default on first run -- after that, it's stored in
# data/point-spinner-state.json and editable live from the Point Spinner
# control panel ("Poin per pesan chat" field), without restarting anything.
CURRENCY_PER_MESSAGE=1

# Minimum seconds between two chat messages counting as "eligible to earn"
# for the SAME viewer, to stop spam-farming. Same "initial default only"
# behavior as CURRENCY_PER_MESSAGE above -- editable later from the Point
# Spinner control panel ("Cooldown" field).
CURRENCY_MESSAGE_COOLDOWN_SECONDS=15

# ---- Manually-granted currency (Exclusive Auction) ---------------------

# Display name for the second, separate currency that is NEVER earned
# automatically -- it only enters circulation when a moderator runs
# `!give "nickname" <amount>` in chat, or uses the "give" form on the
# Exclusive Auction control panel.
EXCLUSIVE_CURRENCY_NAME=Premium Points

# Percentage shaved off every EXCLUSIVE_CURRENCY_NAME balance once a month
# (a pure shrink, not converted into anything else) -- checked hourly,
# applied once per newly-completed calendar month. Set to 0 to disable.
EXCLUSIVE_CURRENCY_DEPRECIATION_PERCENT=5

# ---- YouTube bot (bot/bot.js) ------------------------------------------

# The CHANNEL ID (starts with "UC...") of the channel you stream on --
# NOT the bot/reader account's channel. Find it under YouTube Studio ->
# Settings -> Channel -> Advanced settings -> "Channel ID". See
# docs/SETUP.md for the full walkthrough.
YOUTUBE_CHANNEL_ID=

# Where the bot looks for its Google Cloud OAuth credentials file (the
# JSON you download from Google Cloud Console, see docs/SETUP.md). Left
# at the default, this is bot/client_secret.json.
YOUTUBE_CLIENT_SECRET_PATH=./bot/client_secret.json

# Directory where bot/authorize.js saves the OAuth tokens it generates
# (bot/tokens/main.json and bot/tokens/bot.json). Left at the default,
# this is bot/tokens.
YOUTUBE_TOKENS_DIR=./bot/tokens
